    <string name="th08_files_choose_files">Pilih fail</string>
    <string name="th08_files_remove">Buang fail yang diimport</string>
    <string name="th08_files_remove_title">Buang fail permainan yang diimport?</string>
    <string name="th08_files_remove_body">th08.dat, th08.exe, thbgm.dat dan tampalan bahasa Inggeris yang diimport dipadam daripada storan aplikasi (teks permainan yang dimuat turun di bawah Bahasa kekal). Salinan anda sendiri tidak disentuh; import semula untuk bermain.</string>
