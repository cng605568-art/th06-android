    <string name="start_title">Start</string>
    <string name="start_body">Play opens the game\'s title screen: choose the difficulty, character and shot there; scores and play data are saved (replays are not ported yet). For testing, a stage can be started directly instead.</string>
    <string name="start_skip_title">Skip the title screen (start the chosen stage directly)</string>
    <string name="start_shot">Character and shot type</string>
    <string name="start_difficulty">Difficulty (Extra and Phantasm have their own stage)</string>
    <string name="start_stage">Stage</string>
    <string name="start_lives">Spare lives</string>
    <string name="start_practice">Practice start (full power from stage 2 on; practice runs start with 8 spare lives)</string>

    <string name="controls_title">Controls</string>
    <string name="controls_body">Touch controls for the game (a Bluetooth or USB gamepad works too).</string>
