    <string name="practice_states">Save states (SAVE / LOAD buttons; F5 / F9 on a keyboard, L3 / R3 on a gamepad)</string>

    <string name="mischief_title">Mischief</string>
    <string name="mischief_body">Not in the original game. While any of these is on, scores, clears, spell cards and play records are not saved.</string>

    <string name="music_title">Replace music</string>
